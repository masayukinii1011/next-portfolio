{
	"$schema": "https://biomejs.dev/schemas/1.9.3/schema.json",
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"files": {
		"ignore": ["node_modules", "out", ".next"]
	},
	"overrides": [
		{
			"include": ["src/hooks/use-toast.ts", "src/components/ui/**"],
			"linter": {
				"rules": {
					"complexity": {
						"noForEach": "off"
					},
					"correctness": {
						"useExhaustiveDependencies": "off"
					}
				}
			}
		}
	]
}
